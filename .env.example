# Front-end (públicas)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_APP_BASE_URL=http://localhost:5173

# Edge Functions (secretas — nunca no front; configurar via `supabase secrets set`)
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são injetadas automaticamente no
# runtime das functions — não precisam ser definidas.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=

# WhatsApp (Fase 4). Sem token+phone_number_id, o provedor cai no modo fake
# (loga o código no console em vez de enviar).
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_VERIFICATION=verification_code   # nome do template aprovado na Meta
# WHATSAPP_TEMPLATE_LANG=pt_BR

# Identidade do cliente (Fase 4). CUSTOMER_JWT_SECRET = "JWT Secret" do projeto
# (dashboard → Settings → API); assina o token que carrega o claim customer_id.
# Prefixo SUPABASE_ é reservado pela CLI, por isso o nome próprio.
# CUSTOMER_JWT_SECRET=
# PHONE_TOKEN_PEPPER=            # opcional; tempera o hash do código (cai no JWT secret se ausente)
# WHATSAPP_DEV_ECHO=true         # só em dev + provedor fake: devolve o código na resposta
